
## Ports
PORT=3000
FRONTEND_ORIGIN=http://localhost:8000,http://127.0.0.1:8000,http://0.0.0.0:8000
FRONTEND_URL=http://localhost:8000
POSTGRES_USER=dev
POSTGRES_PASSWORD=dev
POSTGRES_DB=app_dev
POSTGRES_PORT=5432

## Connection string for your app
DATABASE_URL=postgresql://dev:dev@localhost:5432/app_dev

## Email service details
MAIL_SENDER=example@gmail.com
APP_PASSWORD=replace-with-google-app-password

## JWT
JWT_ACCESS_SECRET=replace-with-jwt-access-secret

## Admin account provisioning (set ADMIN_PASSWORD in your local .env only)
ADMIN_EMAIL=admin@friendshop.com
ADMIN_PASSWORD=