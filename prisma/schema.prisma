// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Customer {
  customerID          Int                  @id @default(autoincrement())
  customerForename    String
  customerSurname     String
  address             String
  postcode            String
  customerEmail       String               @unique
  customerPhone       String
  customerPassword    String
  refreshTokens       RefreshToken[]
  passwordResetTokens PasswordResetToken[]
}

model RefreshToken {
  id                  String               @id @default(uuid())
  tokenHash           String               @unique
  familyId            String
  customerID          Int
  customer            Customer             @relation(fields: [customerID], references: [customerID], onDelete: Cascade)
  expiresAt           DateTime
  revokedAt           DateTime?
  replacedById        String?
  createdAt           DateTime             @default(now())
  passwordResetTokens PasswordResetToken[]

  @@index([customerID])
  @@index([familyId])
}

model PasswordResetToken {
  id             Int           @id @default(autoincrement())
  customerEmail  String
  tokenHash      String        @unique
  expiresAt      DateTime
  createdAt      DateTime      @default(now())
  customer       Customer      @relation(fields: [customerEmail], references: [customerEmail], onDelete: Cascade)
  refreshToken   RefreshToken? @relation(fields: [refreshTokenId], references: [id])
  refreshTokenId String?

  @@index([customerEmail])
}

model Product {
  productID          Int    @id @default(autoincrement())
  productName        String
  productDescription String
  productCategory    String
  productPrice       Float
  productImage       String
  productStock       Int
}
