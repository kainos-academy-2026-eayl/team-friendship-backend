// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Customer {
  customerID          Int                  @id @default(autoincrement())
  customerForename    String
  customerSurname     String
  address             String
  postcode            String
  customerEmail       String               @unique
  customerPhone       String
  customerPassword    String
  refreshTokens       RefreshToken[]
  passwordResetTokens PasswordResetToken[]
  orders              Order[]
  basketItems         Basket[]
}

model Staff {
  staffID             Int            @id @default(autoincrement())
  staffForename       String
  staffSurname        String
  staffRole           String         @default("STAFF")
  staffavailability   String         @default("AVAILABLE")
  staffEmail          String         @unique
  staffPassword       String
  refreshTokens       RefreshToken[]
}

model RefreshToken {
  id                  String               @id @default(uuid())
  tokenHash           String               @unique
  familyId            String
  customerID          Int?
  customer            Customer?            @relation(fields: [customerID], references: [customerID], onDelete: Cascade)
  staffID             Int?
  staff               Staff?               @relation(fields: [staffID], references: [staffID], onDelete: Cascade)
  expiresAt           DateTime
  revokedAt           DateTime?
  replacedById        String?
  createdAt           DateTime             @default(now())
  passwordResetTokens PasswordResetToken[]

  @@index([customerID])
  @@index([staffID])
  @@index([familyId])
}

model PasswordResetToken {
  id             Int           @id @default(autoincrement())
  customerEmail  String
  tokenHash      String        @unique
  expiresAt      DateTime
  createdAt      DateTime      @default(now())
  customer       Customer      @relation(fields: [customerEmail], references: [customerEmail], onDelete: Cascade)
  refreshToken   RefreshToken? @relation(fields: [refreshTokenId], references: [id])
  refreshTokenId String?

  @@index([customerEmail])
}

model Product {
  productID          Int    @id @default(autoincrement())
  productName        String
  productDescription String
  productCategory    String
  productPrice       Float
  productImage       String
  productStock       Int

  basketItems Basket[]
  orderServices      OrderService[]
}

model Order {
  orderID       Int            @id @default(autoincrement())
  customerID    Int
  dateCreated   DateTime       @default(now())
  status        String
  customer      Customer       @relation(fields: [customerID], references: [customerID])
  orderServices OrderService[]
}

model OrderService {
  orderID   Int
  productID Int
  quantity  Int
  unitPrice Decimal @db.Decimal(10, 2)
  order     Order   @relation(fields: [orderID], references: [orderID])
  product   Product @relation(fields: [productID], references: [productID])

  @@id([orderID, productID])
}

model Basket {
  basketID   Int @id @default(autoincrement())

  customerID Int
  productID  Int
  quantity   Int

  customer Customer @relation(fields: [customerID], references: [customerID])
  product Product @relation(fields: [productID], references: [productID])

  @@index([customerID])
  @@index([productID])
}