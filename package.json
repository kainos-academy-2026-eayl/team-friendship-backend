{
  "name": "team-friendship-backend",
  "version": "1.0.0",
  "description": "EAYL backend for team friendship! :)",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "npm run typecheck && esbuild src/index.ts --bundle --platform=node --format=esm --target=node22 --packages=external --outfile=dist/index.js --sourcemap",
    "lint": "biome check --error-on-warnings .",
    "lint:fix": "biome check --write --error-on-warnings .",
    "lint:unsafe": "biome check --write --error-on-warnings --unsafe .",
    "prisma:generate": "prisma generate",
    "test": "vitest run",
    "prepare": "node .husky/install.mjs",
    "predev": "prisma generate",
    "typecheck": "prisma generate && tsc",
    "start": "node dist/index.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@biomejs/biome": "^2.6.2",
    "@types/cors": "^2.8.19",
    "@types/express": "5.0.6",
    "@types/node": "26.4.1",
    "esbuild": "0.28.2",
    "husky": "^9.1.7",
    "oxlint": "^1.89.0",
    "prisma": "^7.10.1",
    "tsx": "4.23.13",
    "typescript": "7.0.2",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "argon2": "^0.45.1",
    "cors": "^2.8.6",
    "dotenv": "17.4.2",
    "express": "5.2.1",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": true,
    "prisma@7.10.1": true,
    "@prisma/engines@7.10.1": true
  }
}
